<mjml>
  <mj-head>
    <mj-title>Andela. Flutterwave. PalmPay. One room in Ibadan.</mj-title>
    <mj-preview>The people who built them are speaking at ISF Forum 2026. Here's how to get face time.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', Times, serif" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-text color="#2A3533" font-size="16px" line-height="1.6" padding="0px 40px" />
      <mj-button font-family="Arial, Helvetica, sans-serif" font-size="14px" font-weight="700" letter-spacing="2px" background-color="#F28C28" color="#0F1F1D" border-radius="3px" inner-padding="20px 44px" />
      <mj-class name="label" font-family="Arial, Helvetica, sans-serif" font-size="11px" font-weight="700" letter-spacing="2.5px" line-height="1.5" color="#5CC2B1" />
    </mj-attributes>
    <mj-style>
      a { text-decoration: none; }
      @media only screen and (max-width: 480px) {
        .big div { font-size: 32px !important; }
        .mid div { font-size: 24px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ECF0EF" width="600px">

    <mj-section padding="24px 0 0 0"><mj-column></mj-column></mj-section>

    <!-- Urgency bar -->
    <mj-section background-color="#F28C28" padding="10px 0">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" font-weight="700" letter-spacing="1.5px" color="#0F1F1D" align="center" padding="0 20px">DELEGATE AND VIP PASSES CLOSE 1&nbsp;NOVEMBER</mj-text>
      </mj-column>
    </mj-section>

    <!-- ===== FIXED TOP: speakers animation. Keep in every newsletter. ===== -->
    <mj-section background-color="#FFFFFF">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/shared/isf-speakers-animated.gif" width="600px" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" alt="ISF Forum 2026 speakers. 27 and 28 November, International Conference Centre, Ibadan." />
      </mj-column>
    </mj-section>
    <!-- ===== END FIXED TOP ===== -->

    <!-- Hook -->
    <mj-section background-color="#0F1F1D" padding="48px 0 34px 0">
      <mj-column>
        <mj-text mj-class="label" align="center" padding="0 30px 14px 30px">JUST CONFIRMED</mj-text>
        <mj-text css-class="big" font-size="40px" line-height="1.1" color="#FFFFFF" align="center" padding="0 30px 14px 30px">Andela. Flutterwave. PalmPay. NITDA.</mj-text>
        <mj-text css-class="mid" font-size="26px" line-height="1.25" color="#F28C28" align="center" padding="0 30px">The people behind them. One room. Ibadan.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Speaker grid -->
    <mj-section background-color="#0F1F1D" padding="0 18px">
      <mj-group>
        <mj-column width="50%" padding="0 6px 18px 6px">
          <mj-image src="https://theisfforum.com/speakers/posters/aboyeji.jpg" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" width="264px" border-radius="6px" alt="Iyin Aboyeji, speaker at ISF Forum 2026" />
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" font-weight="700" line-height="1.4" color="#F28C28" align="center" padding="10px 4px 0 4px">Co-founded 2 unicorns: Andela and Flutterwave</mj-text>
        </mj-column>
        <mj-column width="50%" padding="0 6px 18px 6px">
          <mj-image src="https://theisfforum.com/speakers/posters/chika-nwosu.jpg" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" width="264px" border-radius="6px" alt="Chika Nwosu, speaker at ISF Forum 2026" />
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" font-weight="700" line-height="1.4" color="#F28C28" align="center" padding="10px 4px 0 4px">Runs PalmPay: 35M+ users</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#0F1F1D" padding="0 18px">
      <mj-group>
        <mj-column width="50%" padding="0 6px 18px 6px">
          <mj-image src="https://theisfforum.com/speakers/posters/abdullahi.jpg" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" width="264px" border-radius="6px" alt="Kashifu Inuwa Abdullahi, speaker at ISF Forum 2026" />
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" font-weight="700" line-height="1.4" color="#F28C28" align="center" padding="10px 4px 0 4px">Leading Nigeria's push to train 3M people in tech</mj-text>
        </mj-column>
        <mj-column width="50%" padding="0 6px 18px 6px">
          <mj-image src="https://theisfforum.com/speakers/posters/shinada.jpg" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" width="264px" border-radius="6px" alt="Satoshi Shinada, speaker at ISF Forum 2026" />
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" font-weight="700" line-height="1.4" color="#F28C28" align="center" padding="10px 4px 0 4px">Partner at a $43M fund backing African startups</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#0F1F1D" padding="0 18px">
      <mj-group>
        <mj-column width="50%" padding="0 6px 18px 6px">
          <mj-image src="https://theisfforum.com/speakers/posters/adereni.jpg" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" width="264px" border-radius="6px" alt="Dr. Abiodun Adereni, speaker at ISF Forum 2026" />
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" font-weight="700" line-height="1.4" color="#F28C28" align="center" padding="10px 4px 0 4px">HelpMum founder, Ashoka Fellow</mj-text>
        </mj-column>
        <mj-column width="50%" padding="0 6px 18px 6px">
          <mj-image src="https://theisfforum.com/speakers/posters/moses.jpg" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" width="264px" border-radius="6px" alt="Babatunde Akin-Moses, speaker at ISF Forum 2026" />
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" font-weight="700" line-height="1.4" color="#F28C28" align="center" padding="10px 4px 0 4px">Sycamore CEO, Borderless 100</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <mj-section background-color="#0F1F1D" padding="14px 0 48px 0">
      <mj-column>
        <mj-button href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" padding="0 30px 12px 30px">MEET THEM. GET YOUR PASS</mj-button>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" color="#B9C7C4" align="center" padding="0 30px">From &#8358;5,000 &middot; 27 and 28 November &middot; ICC, Ibadan</mj-text>
      </mj-column>
    </mj-section>

    <!-- Host -->
    <mj-section background-color="#FFFFFF" padding="36px 24px">
      <mj-column width="40%" vertical-align="middle">
        <mj-image src="https://theisfforum.com/speakers/makinde.jpg" width="200px" border-radius="6px" alt="His Excellency Seyi Makinde, Executive Governor of Oyo State" />
      </mj-column>
      <mj-column width="60%" vertical-align="middle">
        <mj-text mj-class="label" color="#1E6F64" padding="16px 16px 8px 16px">AND HOSTING US</mj-text>
        <mj-text font-size="24px" line-height="1.25" color="#0F1F1D" padding="0 16px 8px 16px">H.E. Seyi Makinde</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="14px" line-height="1.6" color="#5E6B68" padding="0 16px">Executive Governor of Oyo State, alongside 50+ speakers across two days.</mj-text>
      </mj-column>
    </mj-section>

    <!-- How to meet them -->
    <mj-section background-color="#F4F7F6" padding="40px 0 8px 0">
      <mj-column>
        <mj-text mj-class="label" color="#1E6F64" align="center" padding="0 30px 10px 30px">DON'T JUST WATCH. TALK TO THEM.</mj-text>
        <mj-text css-class="mid" font-size="28px" line-height="1.25" color="#0F1F1D" align="center" padding="0 30px 24px 30px">3 places to get face time</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#F4F7F6" padding="0 24px 40px 24px">
      <mj-column width="33.33%" padding="0 5px 10px 5px">
        <mj-text container-background-color="#FFFFFF" align="center" padding="20px 12px 4px 12px" font-size="30px" line-height="1" color="#F28C28">&#127864;</mj-text>
        <mj-text container-background-color="#FFFFFF" align="center" padding="8px 12px 4px 12px" font-size="17px" line-height="1.3" color="#0F1F1D">Networking reception</mj-text>
        <mj-text container-background-color="#FFFFFF" align="center" padding="0 12px 20px 12px" font-family="Arial, Helvetica, sans-serif" font-size="12px" line-height="1.5" color="#5E6B68">Fri 27 Nov, 5:30 PM</mj-text>
      </mj-column>
      <mj-column width="33.33%" padding="0 5px 10px 5px">
        <mj-text container-background-color="#FFFFFF" align="center" padding="20px 12px 4px 12px" font-size="30px" line-height="1" color="#F28C28">&#127891;</mj-text>
        <mj-text container-background-color="#FFFFFF" align="center" padding="8px 12px 4px 12px" font-size="17px" line-height="1.3" color="#0F1F1D">Masterclasses</mj-text>
        <mj-text container-background-color="#FFFFFF" align="center" padding="0 12px 20px 12px" font-family="Arial, Helvetica, sans-serif" font-size="12px" line-height="1.5" color="#5E6B68">Sat 28 Nov, morning</mj-text>
      </mj-column>
      <mj-column width="33.33%" padding="0 5px 10px 5px">
        <mj-text container-background-color="#FFFFFF" align="center" padding="20px 12px 4px 12px" font-size="30px" line-height="1" color="#F28C28">&#127942;</mj-text>
        <mj-text container-background-color="#FFFFFF" align="center" padding="8px 12px 4px 12px" font-size="17px" line-height="1.3" color="#0F1F1D">Gala Dinner</mj-text>
        <mj-text container-background-color="#FFFFFF" align="center" padding="0 12px 20px 12px" font-family="Arial, Helvetica, sans-serif" font-size="12px" line-height="1.5" color="#5E6B68">Sat 28 Nov, 6 PM</mj-text>
      </mj-column>
    </mj-section>

    <!-- Founders strip -->
    <mj-section background-color="#2F988A" padding="22px 0">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" line-height="1.5" color="#FFFFFF" align="center" padding="0 30px"><strong>Founder?</strong> Pitch to them for a $10,000 grant. Closes 30 Oct. <a href="https://theisfforum.com/pitch" style="color:#0F1F1D;font-weight:700;text-decoration:underline;">Apply &rarr;</a></mj-text>
      </mj-column>
    </mj-section>

    <!-- Final CTA -->
    <mj-section background-color="#FFFFFF" padding="44px 0 40px 0">
      <mj-column>
        <mj-text css-class="mid" font-size="28px" line-height="1.25" color="#0F1F1D" align="center" padding="0 30px 20px 30px">Your seat is waiting.</mj-text>
        <mj-button href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" padding="0 30px 12px 30px">GET YOUR PASS FROM &#8358;5,000</mj-button>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="13px" color="#C8641A" font-weight="700" align="center" padding="0 30px 26px 30px">Delegate and VIP passes close 1 November</mj-text>
        <mj-social mode="horizontal" align="center" icon-size="36px" padding="0" inner-padding="0 8px" border-radius="18px">
          <mj-social-element name="instagram-noshare" href="https://www.instagram.com/innovationandscaleforum/" src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/social/isf-instagram.png" background-color="#FFFFFF" alt="Instagram"></mj-social-element>
          <mj-social-element name="linkedin-noshare" href="https://www.linkedin.com/company/isfforum" src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/social/isf-linkedin.png" background-color="#FFFFFF" alt="LinkedIn"></mj-social-element>
          <mj-social-element name="x-noshare" href="https://x.com/OfficialISF2026" src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/social/isf-x.png" background-color="#FFFFFF" alt="X"></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>

    <!-- Partners -->
    <mj-section background-color="#FFFFFF" padding="0 0 30px 0">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/october/isf-partners.png" width="520px" alt="Partners of ISF Forum 2026" padding="0 20px" />
      </mj-column>
    </mj-section>

    <!-- ===== FIXED BOTTOM: Ibadan banner. Keep in every newsletter. ===== -->
    <mj-section background-color="#0F1F1D">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/speakers-oct/isf-big-ideas-banner.jpg" width="600px" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" alt="Where big ideas meet big opportunities. ISF Forum 2026, 27 and 28 November, ICC Ibadan." />
      </mj-column>
    </mj-section>
    <!-- ===== END FIXED BOTTOM ===== -->

    <!-- Footer -->
    <mj-section background-color="#0F1F1D" padding="28px 0 30px 0">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" color="#B9C7C4" font-size="12px" line-height="1.8" align="center" padding="0 24px 12px 24px"><a href="https://theisfforum.com" style="color:#FFFFFF;">theisfforum.com</a> &nbsp;|&nbsp; <a href="mailto:events@theisfforum.com" style="color:#FFFFFF;">events@theisfforum.com</a></mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" color="#7F918D" font-size="11px" line-height="1.6" align="center" padding="0 48px">You are receiving this email because you subscribed to updates from ISF Forum. <a href="{{UNSUBSCRIBE_URL}}" style="color:#B9C7C4;text-decoration:underline;">Unsubscribe</a></mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0"><mj-column></mj-column></mj-section>

  </mj-body>
</mjml>
