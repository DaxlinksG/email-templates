<mjml>
  <mj-head>
    <mj-title>Nigeria's data protection chief is coming to Ibadan</mj-title>
    <mj-preview>Dr. Vincent O. Olatunji speaks at ISF Forum 2026, and the NDPC is hosting a session for founders.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-text color="#222222" font-size="16px" line-height="1.65" padding="0 36px 16px 36px" />
    </mj-attributes>
    <mj-style>
      a { color: #1E6F64; }
      @media only screen and (max-width: 480px) {
        .hero div { font-size: 31px !important; }
        .tbd div { font-size: 34px !important; text-align: center !important; }
        .ctr div { text-align: center !important; }
        .tilev div { font-size: 19px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F2F4F3" width="600px">

    <mj-section padding="22px 0 10px 0">
      <mj-column>
        <mj-text font-size="12px" line-height="1.5" color="#5E6B68" align="center" padding="0 24px">ISF Forum 2026 &middot; Saturday 28 November &middot; ICC Ibadan</mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero: headline on white, portrait fades into black -->
    <mj-section background-color="#FFFFFF" border-radius="6px 6px 0 0" padding="36px 0 0 0">
      <mj-column>
        <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" line-height="1" padding="0 30px 18px 30px"><span style="background:#2E9A8A;color:#FFFFFF;padding:7px 14px;border-radius:14px;display:inline-block;">SPECIAL ANNOUNCEMENT</span></mj-text>
        <mj-text css-class="hero" align="center" font-size="40px" font-weight="700" line-height="1.1" color="#0F1F1D" padding="0 30px 0 30px">Nigeria's data protection chief is <span style="color:#2E9A8A;">coming&nbsp;to&nbsp;Ibadan.</span></mj-text>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/aecf50229e5e770e70b4d27bd928754dd703897e/isf-2026/speaker-nov/olatunji-hero.jpg" width="600px" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" alt="Speaker: Dr. Vincent O. Olatunji, National Commissioner and CEO, Nigeria Data Protection Commission (NDPC)." />
      </mj-column>
    </mj-section>

    <mj-section background-color="#000000" padding="4px 0 36px 0">
      <mj-column>
        <mj-text align="center" font-size="14px" line-height="1.7" color="#9FB0AC" padding="0 36px 18px 36px">30+&nbsp;years&nbsp;in&nbsp;ICT&nbsp;policy &nbsp;&middot;&nbsp; Former&nbsp;Acting&nbsp;DG,&nbsp;NITDA &nbsp;&middot;&nbsp; PhD,&nbsp;University&nbsp;of&nbsp;Lagos</mj-text>
        <mj-text align="center" font-size="17px" line-height="1.6" color="#FFFFFF" padding="0 40px 24px 40px">He is speaking at ISF Forum 2026, and his Commission is bringing a special session for founders.</mj-text>
        <mj-button href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" background-color="#F28C28" color="#0F1F1D" font-size="17px" font-weight="700" border-radius="6px" inner-padding="16px 38px" align="center" padding="0 36px">Get my pass</mj-button>
      </mj-column>
    </mj-section>

    <!-- Session: Trust by Design -->
    <mj-section background-color="#F7FFFE" padding="34px 24px 6px 24px">
      <mj-column width="56%" vertical-align="middle">
        <mj-text css-class="ctr" font-size="12px" font-weight="700" letter-spacing="2px" color="#1E6F64" padding="0 12px 8px 12px">NDPC BREAKOUT SESSION</mj-text>
        <mj-text css-class="tbd" font-size="36px" font-weight="700" line-height="1.05" color="#0F1F1D" padding="0 12px 10px 12px">Trust by <span style="color:#2E9A8A;">Design</span></mj-text>
        <mj-text css-class="ctr" font-size="15px" line-height="1.55" color="#4A5A57" padding="0 12px 10px 12px">Protecting customer data and building responsible businesses in the digital economy.</mj-text>
      </mj-column>
      <mj-column width="44%" vertical-align="middle">
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/01fd68f9ee1f5ed66609f360d31b4133a404eb5a/isf-2026/ndpc-nov/ndpc-shield.jpg" width="240px" align="center" alt="A teal shield with a person icon, a padlock and a message bubble: protecting customer data." />
      </mj-column>
    </mj-section>

    <mj-section background-color="#F7FFFE" padding="14px 24px 32px 24px">
      <mj-group width="100%">
        <mj-column width="33.33%" padding="0 6px" inner-background-color="#E3F4F0" inner-border-radius="8px">
          <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#1E6F64" padding="14px 6px 2px 6px">DATE</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.2" color="#0F1F1D" padding="0 6px 14px 6px">28 NOV</mj-text>
        </mj-column>
        <mj-column width="33.33%" padding="0 6px" inner-background-color="#E3F4F0" inner-border-radius="8px">
          <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#1E6F64" padding="14px 6px 2px 6px">SESSION</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.2" color="#0F1F1D" padding="0 6px 14px 6px">90 MIN</mj-text>
        </mj-column>
        <mj-column width="33.33%" padding="0 6px" inner-background-color="#E3F4F0" inner-border-radius="8px">
          <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#1E6F64" padding="14px 6px 2px 6px">PLACE</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.2" color="#0F1F1D" padding="0 6px 14px 6px">IBADAN</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- Intro + who -->
    <mj-section background-color="#FFFFFF" padding="32px 0 0 0">
      <mj-column>
        <mj-text>Hi there,</mj-text>
        <mj-text>Every business that serves customers also holds their data. Through its Digital Privacy Awareness Campaign, the <strong>Nigeria Data Protection Commission</strong> is hosting a 90-minute breakout at ISF Forum for:</mj-text>
        <mj-text align="center" font-size="14px" font-weight="700" line-height="2.9" color="#1E6F64" padding="0 30px 18px 30px"><span style="background:#E3F4F0;padding:7px 14px;border-radius:16px;white-space:nowrap;">Founders</span>&nbsp; <span style="background:#E3F4F0;padding:7px 14px;border-radius:16px;white-space:nowrap;">Entrepreneurs</span>&nbsp; <span style="background:#E3F4F0;padding:7px 14px;border-radius:16px;white-space:nowrap;">Small business owners</span>&nbsp; <span style="background:#E3F4F0;padding:7px 14px;border-radius:16px;white-space:nowrap;">Young innovators</span></mj-text>
        <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#1E6F64" padding="6px 36px 12px 36px">WHAT HAPPENS IN THE ROOM</mj-text>
      </mj-column>
    </mj-section>

    <!-- Format 1 -->
    <mj-wrapper background-color="#FFFFFF" padding="0 36px 10px 36px">
      <mj-section background-color="#EEF6F4" border-radius="8px" padding="0">
      <mj-group width="100%">
        <mj-column width="18%" padding="18px 0 0 0">
          <mj-text align="center" font-size="22px" font-weight="700" line-height="40px" color="#0F1F1D" padding="0"><span style="display:inline-block;width:40px;height:40px;line-height:40px;border-radius:20px;background:#F28C28;">1</span></mj-text>
        </mj-column>
        <mj-column width="82%" padding="16px 0 6px 0">
          <mj-text font-size="12px" font-weight="700" letter-spacing="1.5px" color="#1E6F64" padding="0 18px 2px 0">PRIVACY MASTERCLASS</mj-text>
          <mj-text font-size="16px" font-weight="700" line-height="1.4" color="#0F1F1D" padding="0 18px 10px 0">The Business of Personal Data: What Every Founder Needs to Know</mj-text>
        </mj-column>
      </mj-group>
      </mj-section>
    </mj-wrapper>

    <!-- Format 2 -->
    <mj-wrapper background-color="#FFFFFF" padding="0 36px 10px 36px">
      <mj-section background-color="#EEF6F4" border-radius="8px" padding="0">
      <mj-group width="100%">
        <mj-column width="18%" padding="18px 0 0 0">
          <mj-text align="center" font-size="22px" font-weight="700" line-height="40px" color="#0F1F1D" padding="0"><span style="display:inline-block;width:40px;height:40px;line-height:40px;border-radius:20px;background:#F28C28;">2</span></mj-text>
        </mj-column>
        <mj-column width="82%" padding="16px 0 6px 0">
          <mj-text font-size="12px" font-weight="700" letter-spacing="1.5px" color="#1E6F64" padding="0 18px 2px 0">FIRESIDE CHAT</mj-text>
          <mj-text font-size="16px" font-weight="700" line-height="1.4" color="#0F1F1D" padding="0 18px 10px 0">Can Your Customers Trust You? Data Protection and the Future of Business in Nigeria</mj-text>
        </mj-column>
      </mj-group>
      </mj-section>
    </mj-wrapper>

    <!-- Format 3 -->
    <mj-wrapper background-color="#FFFFFF" padding="0 36px 28px 36px">
      <mj-section background-color="#EEF6F4" border-radius="8px" padding="0">
      <mj-group width="100%">
        <mj-column width="18%" padding="18px 0 0 0">
          <mj-text align="center" font-size="22px" font-weight="700" line-height="40px" color="#0F1F1D" padding="0"><span style="display:inline-block;width:40px;height:40px;line-height:40px;border-radius:20px;background:#F28C28;">3</span></mj-text>
        </mj-column>
        <mj-column width="82%" padding="16px 0 6px 0">
          <mj-text font-size="12px" font-weight="700" letter-spacing="1.5px" color="#1E6F64" padding="0 18px 2px 0">INTERACTIVE ENGAGEMENT</mj-text>
          <mj-text font-size="16px" font-weight="700" line-height="1.4" color="#0F1F1D" padding="0 18px 10px 0">Practical scenarios on customer data protection and business privacy</mj-text>
        </mj-column>
      </mj-group>
      </mj-section>
    </mj-wrapper>

    <!-- Outcome + CTA -->
    <mj-section background-color="#0F1F1D" padding="30px 0 34px 0">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#5CC2B1" padding="0 36px 8px 36px">YOU WILL LEAVE KNOWING</mj-text>
        <mj-text font-size="17px" line-height="1.6" color="#FFFFFF" padding="0 36px 22px 36px">Your responsibilities under the Nigeria Data Protection Act 2023, and how handling customer data well builds trust and lasting growth.</mj-text>
        <mj-button href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" background-color="#F28C28" color="#0F1F1D" font-size="16px" font-weight="700" border-radius="6px" inner-padding="15px 36px" align="center" padding="0 36px 18px 36px">Get my pass</mj-button>
        <mj-text align="center" font-size="14px" line-height="1.6" color="#B9C7C4" padding="0 36px">Bring the teammate who looks after your customer data.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="26px 0 8px 0">
      <mj-column>
        <mj-text padding="0 36px 24px 36px">See you in Ibadan,<br />The ISF Forum 2026 team</mj-text>
      </mj-column>
    </mj-section>

    <!-- FIXED BOTTOM: Ibadan banner -->
    <mj-section background-color="#FFFFFF" border-radius="0 0 6px 6px">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/speakers-oct/isf-big-ideas-banner.jpg" width="600px" border-radius="0 0 6px 6px" href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" alt="ISF Forum 2026 banner showing the Ibadan skyline" />
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="22px 0 30px 0">
      <mj-column>
        <mj-text font-size="13px" line-height="1.6" color="#666666" align="center" padding="0 32px 8px 32px">Follow us: <a href="https://www.instagram.com/innovationandscaleforum" style="color:#1E6F64;">Instagram</a> &middot; <a href="https://www.linkedin.com/company/isfforum" style="color:#1E6F64;">LinkedIn</a></mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">ISF Forum &middot; Ibadan, Oyo State, Nigeria</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">You are receiving this email because you subscribed to updates from ISF Forum.</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px"><a href="{{UNSUBSCRIBE_URL}}" style="color:#666666;text-decoration:underline;">Unsubscribe</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
