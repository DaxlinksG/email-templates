<mjml>
  <mj-head>
    <mj-title>Two live masterclasses for founders, starting Thursday</mj-title>
    <mj-preview>Two Zoom sessions with inDrive Nigeria and OnePipe, on 5 and 12 November at 6 PM.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-text color="#222222" font-size="16px" line-height="1.65" padding="0 36px 16px 36px" />
    </mj-attributes>
    <mj-style>
      a { color: #1E6F64; }
      @media only screen and (max-width: 480px) {
        .hero div { font-size: 30px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F2F4F3" width="600px">

    <mj-section padding="22px 0 10px 0">
      <mj-column>
        <mj-text font-size="12px" line-height="1.5" color="#5E6B68" align="center" padding="0 24px">ISF Forum 2026 &middot; Saturday 28 November &middot; ICC Ibadan</mj-text>
      </mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section background-color="#0F1F1D" border-radius="6px 6px 0 0" padding="38px 0 34px 0">
      <mj-column>
        <mj-text align="center" font-size="13px" font-weight="700" letter-spacing="3px" color="#5CC2B1" padding="0 30px 12px 30px">LIVE ON ZOOM &middot; FOR FOUNDERS</mj-text>
        <mj-text css-class="hero" align="center" font-family="Georgia, 'Times New Roman', serif" font-size="38px" line-height="1.15" color="#FFFFFF" padding="0 30px 14px 30px">Virtual Masterclasses</mj-text>
        <mj-text align="center" font-size="15px" line-height="1.6" color="#B9C7C4" padding="0 44px">Two sessions to sharpen your deck, your numbers and your ask before Ibadan.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Posters -->
    <mj-section background-color="#FFFFFF" padding="30px 24px 8px 24px">
      <mj-column width="50%" padding="0 6px 18px 6px">
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/masterclass-nov/masterclass-1-investors-deck.jpg" alt="Virtual Masterclass: How Investors Read Your Deck, with Oladimeji Timothy, Country Director, inDrive Nigeria. Thursday 5 November 2026, 6:00 PM WAT, on Zoom." border-radius="6px" />
        <mj-text font-size="14px" line-height="1.5" color="#3E4B48" align="center" padding="10px 0 0 0">Thursday 5 November, 6:00 PM WAT</mj-text>
      </mj-column>
      <mj-column width="50%" padding="0 6px 18px 6px">
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/masterclass-nov/masterclass-2-numbers-that-matter.jpg" alt="Virtual Masterclass: The Numbers That Matter, Traction, Unit Economics and Your Funding Ask, with Yvonne-Faith Elaigwu, Head of Operations and Governance, OnePipe. Thursday 12 November 2026, 6:00 PM WAT, on Zoom." border-radius="6px" />
        <mj-text font-size="14px" line-height="1.5" color="#3E4B48" align="center" padding="10px 0 0 0">Thursday 12 November, 6:00 PM WAT</mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#FFFFFF" padding="0 0 8px 0">
      <mj-column>
        <mj-text>Founders are welcome. Share your details and we will send you the Zoom link.</mj-text>
        <mj-button href="https://docs.google.com/forms/d/e/1FAIpQLSdxDAwtyYrubnd839tW7-UhuUfAxdFs5mtvIThYTWdy_Unpxg/viewform" background-color="#1E6F64" color="#FFFFFF" font-size="16px" font-weight="700" border-radius="4px" inner-padding="14px 30px" align="left" padding="4px 36px 22px 36px">Register your interest</mj-button>
        <mj-text><strong>Applied to the Pitch Battle for the $10,000 grant?</strong> Please check your email, including spam, and keep an eye on your inbox over the coming days.</mj-text>
        <mj-text padding="0 36px 10px 36px">The Forum itself is on Saturday 28 November at the International Conference Centre, Ibadan.</mj-text>
        <mj-button href="https://tickets.theisfforum.com/#/buyTickets/selectTickets?lang=en" background-color="#F28C28" color="#0F1F1D" font-size="14px" font-weight="700" border-radius="4px" inner-padding="10px 22px" align="left" padding="0 36px 22px 36px">Basic passes from &#8358;5,000</mj-button>
        <mj-text font-size="15px" line-height="1.6" color="#3E4B48">P.S. Do people actually watch your WhatsApp status? Join the <a href="https://chat.whatsapp.com/DsRcIiB3aLSLNEgpGBg7aG?mode=gi_t" style="color:#1E6F64;text-decoration:underline;">ISF Scale Squad</a>: share our flyers and posts on your status, groups and pages, and drop a screenshot in the group each time. Our most active members receive passes to ISF Forum 2026, a few top promoters get a cash stipend, and the top sharers are shouted out every week.</mj-text>
        <mj-text padding="6px 36px 34px 36px">See you on Zoom,<br />David Adeleke<br /><span style="color:#5E6B68;">Convener, ISF Forum</span></mj-text>
      </mj-column>
    </mj-section>

    <!-- FIXED BOTTOM: Ibadan banner -->
    <mj-section background-color="#FFFFFF" border-radius="0 0 6px 6px">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/speakers-oct/isf-big-ideas-banner.jpg" width="600px" border-radius="0 0 6px 6px" alt="ISF Forum 2026 banner showing the Ibadan skyline" />
      </mj-column>
    </mj-section>

    <mj-section padding="22px 0 30px 0">
      <mj-column>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">ISF Forum &middot; Ibadan, Oyo State, Nigeria</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">You are receiving this email because you subscribed to updates from ISF Forum.</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px"><a href="{{UNSUBSCRIBE_URL}}" style="color:#666666;text-decoration:underline;">Unsubscribe</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
