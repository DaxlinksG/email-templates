<mjml>
  <mj-head>
    <mj-title>Where does your growth go next?</mj-title>
    <mj-preview>By invitation. Saturday 28 November, 2 to 4 pm, Ibadan. Express your interest.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-text color="#222222" font-size="16px" line-height="1.65" padding="0 36px 16px 36px" />
    </mj-attributes>
    <mj-style>
      a { color: #1E6F64; }
      @media only screen and (max-width: 480px) {
        .hero div { font-size: 32px !important; }
        .tilev div { font-size: 19px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F2F4F3" width="600px">

    <mj-section padding="22px 0 10px 0">
      <mj-column>
        <mj-text font-size="12px" line-height="1.5" color="#5E6B68" align="center" padding="0 24px">ISF Forum 2026 &middot; Saturday 28 November &middot; Ibadan</mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#0F1F1D" border-radius="6px 6px 0 0" padding="40px 0 6px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" font-weight="700" letter-spacing="3px" color="#5CC2B1" padding="0 30px 14px 30px">BY INVITATION ONLY</mj-text>
        <mj-text css-class="hero" align="center" font-size="40px" font-weight="700" line-height="1.1" color="#FFFFFF" padding="0 28px 14px 28px">Where does your growth go <span style="color:#F28C28;">next?</span></mj-text>
        <mj-text align="center" font-size="16px" line-height="1.6" color="#B9C7C4" padding="0 40px 24px 40px">International Growth Pathways: a private roundtable for founders and ecosystem leaders in Ibadan.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Route graphic -->
    <mj-section background-color="#0F1F1D" padding="0">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/77e18c5466ac3a83c8dffeda57688de768ee8f23/isf-2026/roundtable-nov/roundtable-route.jpg" width="600px" href="https://luma.com/e3m89ztl" alt="A route from Ibadan, where you build, to the United Kingdom, the OpenLane focus, with other markets beyond. OpenLane and ISF." />
      </mj-column>
    </mj-section>

    <!-- Date tiles -->
    <mj-section background-color="#0F1F1D" padding="18px 24px 8px 24px">
      <mj-group width="100%">
        <mj-column width="33.33%" padding="0 6px" inner-background-color="#17332F" inner-border-radius="8px">
          <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#5CC2B1" padding="14px 6px 2px 6px">DATE</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.2" color="#FFFFFF" padding="0 6px 14px 6px">28 NOV</mj-text>
        </mj-column>
        <mj-column width="33.33%" padding="0 6px" inner-background-color="#17332F" inner-border-radius="8px">
          <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#5CC2B1" padding="14px 6px 2px 6px">TIME</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.2" color="#FFFFFF" padding="0 6px 14px 6px">2&ndash;4 PM</mj-text>
        </mj-column>
        <mj-column width="33.33%" padding="0 6px" inner-background-color="#17332F" inner-border-radius="8px">
          <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#5CC2B1" padding="14px 6px 2px 6px">PLACE</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.2" color="#FFFFFF" padding="0 6px 14px 6px">IBADAN</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <mj-section background-color="#0F1F1D" padding="20px 0 34px 0">
      <mj-column>
        <mj-button href="https://luma.com/e3m89ztl" background-color="#F28C28" color="#0F1F1D" font-size="17px" font-weight="700" border-radius="6px" inner-padding="16px 36px" align="center" padding="0 36px">Express your interest</mj-button>
      </mj-column>
    </mj-section>

    <!-- Intro -->
    <mj-section background-color="#FFFFFF" padding="32px 0 0 0">
      <mj-column>
        <mj-text>Hi there,</mj-text>
        <mj-text>POV and ISF Forum are bringing growth-stage founders and ecosystem leaders in Ibadan and the wider South-West into one room to talk about <strong>going global</strong>, with a focus on the UK.</mj-text>
        <mj-text>It is part of <strong>OpenLane</strong>, supported by the UK&ndash;Nigeria Tech Hub. We want to hear your ambitions, the markets you are eyeing, and the barriers you have met.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Who -->
    <mj-section background-color="#FFFFFF" padding="6px 0 8px 0">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" letter-spacing="1.5px" color="#1E6F64" padding="0 36px 12px 36px">WHO SHOULD EXPRESS INTEREST</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 30px 10px 30px">
      <mj-column width="50%" padding="0 6px 12px 6px" inner-background-color="#EEF6F4" inner-border-radius="8px">
        <mj-text font-size="11px" font-weight="700" letter-spacing="1.5px" color="#1E6F64" padding="18px 18px 4px 18px">FOUNDERS</mj-text>
        <mj-text font-size="38px" font-weight="700" line-height="1.1" color="#0F1F1D" padding="0 18px 2px 18px">US$10K</mj-text>
        <mj-text font-size="13px" font-weight="700" line-height="1.4" color="#1E6F64" padding="0 18px 8px 18px">monthly recurring revenue, preferably</mj-text>
        <mj-text font-size="14px" line-height="1.55" color="#3E4B48" padding="0 18px 18px 18px">Tech-enabled companies in Ibadan with established commercial traction.</mj-text>
      </mj-column>
      <mj-column width="50%" padding="0 6px 12px 6px" inner-background-color="#0F1F1D" inner-border-radius="8px">
        <mj-text font-size="11px" font-weight="700" letter-spacing="1.5px" color="#5CC2B1" padding="18px 18px 4px 18px">INVESTORS AND ECOSYSTEM LEADERS</mj-text>
        <mj-text font-size="30px" font-weight="700" line-height="1.15" color="#FFFFFF" padding="0 18px 8px 18px">Growth stage</mj-text>
        <mj-text font-size="14px" line-height="1.55" color="#B9C7C4" padding="0 18px 18px 18px">Actively supporting growth-stage companies.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 36px 24px 36px">
      <mj-column background-color="#FFF3E6" border-left="4px solid #F28C28" border-radius="6px" padding="12px 0 0 0">
        <mj-text font-size="14px" line-height="1.55" color="#5B3A12" padding="0 18px 12px 18px"><strong>Priority goes to organisations with active operations in Ibadan.</strong></mj-text>
      </mj-column>
    </mj-section>

    <!-- Steps -->
    <mj-section background-color="#FFFFFF" padding="0 36px 8px 36px">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/77e18c5466ac3a83c8dffeda57688de768ee8f23/isf-2026/roundtable-nov/roundtable-steps.jpg" width="528px" align="center" border-radius="8px" href="https://luma.com/e3m89ztl" alt="How it works. Step 1: express interest on the Luma page. Step 2: we review every application. Step 3: if you are selected, you hear from us directly with venue details." />
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#FFFFFF" padding="16px 0 0 0">
      <mj-column>
        <mj-text align="center" font-size="14px" color="#5E6B68" padding="0 36px 14px 36px">Participation is strictly by invitation.</mj-text>
        <mj-button href="https://luma.com/e3m89ztl" background-color="#1E6F64" color="#FFFFFF" font-size="16px" font-weight="700" border-radius="6px" inner-padding="15px 34px" align="center" padding="0 36px 22px 36px">Express your interest</mj-button>
        <mj-text>Know a founder in Ibadan who belongs in this room? Forward this email.</mj-text>
        <mj-text padding="6px 36px 34px 36px">Warm regards,<br />The ISF Forum 2026 team</mj-text>
      </mj-column>
    </mj-section>

    <!-- FIXED BOTTOM: Ibadan banner -->
    <mj-section background-color="#FFFFFF" border-radius="0 0 6px 6px">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/speakers-oct/isf-big-ideas-banner.jpg" width="600px" border-radius="0 0 6px 6px" href="https://luma.com/e3m89ztl" alt="ISF Forum 2026 banner showing the Ibadan skyline" />
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="22px 0 30px 0">
      <mj-column>
        <mj-text font-size="13px" line-height="1.6" color="#666666" align="center" padding="0 32px 8px 32px">Follow us: <a href="https://www.instagram.com/innovationandscaleforum" style="color:#1E6F64;">Instagram</a> &middot; <a href="https://www.linkedin.com/company/isfforum" style="color:#1E6F64;">LinkedIn</a></mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">ISF Forum &middot; Ibadan, Oyo State, Nigeria</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">You are receiving this email because you subscribed to updates from ISF Forum.</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px"><a href="{{UNSUBSCRIBE_URL}}" style="color:#666666;text-decoration:underline;">Unsubscribe</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
