<mjml>
  <mj-head>
    <mj-title>Your ISF weekend now comes with popcorn and a pool</mj-title>
    <mj-preview>Movie Night on Friday 27 November, then Pool-Up After ISF on Saturday. You're invited to both.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-text color="#222222" font-size="16px" line-height="1.65" padding="0 36px 16px 36px" />
    </mj-attributes>
    <mj-style>
      a { color: #1E6F64; }
      @media only screen and (max-width: 480px) {
        .hero div { font-size: 32px !important; }
        .big div { font-size: 38px !important; }
        .tilev div { font-size: 20px !important; }
        .tilen div { font-size: 12px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F2F4F3" width="600px">

    <mj-section padding="22px 0 10px 0">
      <mj-column>
        <mj-text font-size="12px" line-height="1.5" color="#5E6B68" align="center" padding="0 24px">ISF Forum 2026 &middot; The weekend edition &middot; Ibadan</mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#111111" border-radius="6px 6px 0 0" padding="36px 0 24px 0">
      <mj-column>
        <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" line-height="1" padding="0 30px 18px 30px"><span style="background:#FFD23F;color:#111111;padding:7px 14px;border-radius:14px;display:inline-block;">THE ISF WEEKEND, EXTENDED</span></mj-text>
        <mj-text css-class="hero" align="center" font-size="42px" font-weight="700" line-height="1.12" color="#FFFFFF" padding="0 24px 14px 24px"><span style="color:#F28C28;">Popcorn</span> Friday.<br /><span style="color:#2EC4F1;">Poolside</span> Saturday.</mj-text>
        <mj-text align="center" font-size="16px" line-height="1.6" color="#BDBDBD" padding="0 40px 0 40px">ISF Forum 2026 just got a prequel and an afterparty. You're invited to both.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#111111" padding="0">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/5a4821eefc46c2abbed79a63eac644bc199ac96f/isf-2026/weekend-nov/isf-weekend-hero.jpg" width="600px" href="https://luma.com/14glbn7b" alt="Two posters on a film strip. The prequel: Movie Night, Friday 27. The afterparty: Pool-Up After ISF, Saturday 28." />
      </mj-column>
    </mj-section>

    <!-- Weekend plan tiles -->
    <mj-section background-color="#111111" padding="4px 24px 32px 24px">
      <mj-group width="100%">
        <mj-column width="33.33%" padding="0 5px" inner-background-color="#222222" inner-border-radius="10px">
          <mj-text align="center" font-size="10px" font-weight="700" letter-spacing="1px" color="#FFD23F" padding="14px 4px 2px 4px">PREQUEL</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.15" color="#FFFFFF" padding="0 4px 2px 4px">FRI 27</mj-text>
          <mj-text css-class="tilen" align="center" font-size="14px" line-height="1.3" color="#BDBDBD" padding="0 4px 14px 4px">Movie Night</mj-text>
        </mj-column>
        <mj-column width="33.33%" padding="0 5px" inner-background-color="#222222" inner-border-radius="10px">
          <mj-text align="center" font-size="10px" font-weight="700" letter-spacing="1px" color="#F28C28" padding="14px 4px 2px 4px">MAIN EVENT</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.15" color="#FFFFFF" padding="0 4px 2px 4px">SAT 28</mj-text>
          <mj-text css-class="tilen" align="center" font-size="14px" line-height="1.3" color="#BDBDBD" padding="0 4px 14px 4px">ISF Forum</mj-text>
        </mj-column>
        <mj-column width="33.33%" padding="0 5px" inner-background-color="#222222" inner-border-radius="10px">
          <mj-text align="center" font-size="10px" font-weight="700" letter-spacing="1px" color="#2EC4F1" padding="14px 4px 2px 4px">AFTERPARTY</mj-text>
          <mj-text css-class="tilev" align="center" font-size="26px" font-weight="700" line-height="1.15" color="#FFFFFF" padding="0 4px 2px 4px">SAT 28</mj-text>
          <mj-text css-class="tilen" align="center" font-size="14px" line-height="1.3" color="#BDBDBD" padding="0 4px 14px 4px">Pool-Up</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- Intro -->
    <mj-section background-color="#FFFFFF" padding="30px 0 6px 0">
      <mj-column>
        <mj-text>Hello,</mj-text>
        <mj-text>The conversations don't have to wait for ISF to start, and they don't have to end when it wraps up.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Movie Night -->
    <mj-section background-color="#FFF6EC" padding="32px 0 6px 0">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#C2410C" padding="0 36px 6px 36px">THE PREQUEL &middot; FRI 27 NOV</mj-text>
        <mj-text css-class="big" font-family="'Arial Black', Arial, Helvetica, sans-serif" font-size="46px" font-weight="900" line-height="1.05" padding="0 36px 14px 36px"><span style="color:#F28C28;">MOVIE</span> <span style="color:#22A892;">NIGHT</span></mj-text>
        <mj-text>Ibadan Start-up Fest and Caf&eacute; One are rolling out the red seats. Good movies, popcorn, drinks and great company.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFF6EC" padding="0 36px 0 36px">
      <mj-column background-color="#FFFFFF" border="2px dashed #F28C28" border-radius="10px" padding="16px 0 2px 0">
        <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#C2410C" padding="0 16px 4px 16px">FRI 27 NOV &middot; 5 PM</mj-text>
        <mj-text align="center" font-size="20px" font-weight="700" line-height="1.3" color="#111111" padding="0 16px 4px 16px">Caf&eacute; One, Bodija</mj-text>
        <mj-text align="center" font-size="14px" line-height="1.5" color="#555555" padding="0 16px 14px 16px">No charge to attend. Registration is compulsory.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFF6EC" padding="22px 0 30px 0">
      <mj-column>
        <mj-button href="https://luma.com/14glbn7b" background-color="#C62828" color="#FFFFFF" font-size="17px" font-weight="700" border-radius="6px" inner-padding="16px 38px" align="center" padding="0 36px 14px 36px">Save my seat</mj-button>
        <mj-text align="center" font-size="14px" font-style="italic" line-height="1.5" color="#8A5A3C" padding="0 36px">Come for the film. Stay for the person in the next seat.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Pool-Up -->
    <mj-section background-color="#0A1A3F" padding="34px 0 6px 0">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" letter-spacing="2px" color="#2EC4F1" padding="0 36px 6px 36px">THE AFTERPARTY &middot; SAT 28 NOV</mj-text>
        <mj-text css-class="big" font-family="'Arial Black', Arial, Helvetica, sans-serif" font-size="46px" font-weight="900" line-height="1.05" color="#FFFFFF" padding="0 36px 8px 36px">POOL-UP <span style="color:#4C8DFF;">AFTER&nbsp;ISF</span></mj-text>
        <mj-text font-size="18px" font-style="italic" line-height="1.4" color="#C9D6F2" padding="0 36px 16px 36px">Business by day. Poolside by night.</mj-text>
        <mj-text color="#E6ECF8">When the last panel is done, bring the conversations to the pool. Unwind and connect with fellow ISF attendees in a relaxed poolside atmosphere.</mj-text>
        <mj-text font-size="14px" font-weight="700" line-height="2.9" color="#FFFFFF" padding="0 36px 14px 36px"><span style="background:#16295A;border:1px solid #2F5BB7;padding:6px 13px;border-radius:16px;white-space:nowrap;">Pool vibes</span>&nbsp; <span style="background:#16295A;border:1px solid #2F5BB7;padding:6px 13px;border-radius:16px;white-space:nowrap;">Food &amp; drinks</span>&nbsp; <span style="background:#16295A;border:1px solid #2F5BB7;padding:6px 13px;border-radius:16px;white-space:nowrap;">Live DJ</span>&nbsp; <span style="background:#16295A;border:1px solid #2F5BB7;padding:6px 13px;border-radius:16px;white-space:nowrap;">Network &amp; connect</span></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#0A1A3F" padding="0 36px 0 36px">
      <mj-column background-color="#10244F" border="2px dashed #2EC4F1" border-radius="10px" padding="16px 0 2px 0">
        <mj-text align="center" font-size="11px" font-weight="700" letter-spacing="2px" color="#2EC4F1" padding="0 16px 4px 16px">SAT 28 NOV &middot; FROM 5 PM</mj-text>
        <mj-text align="center" font-size="20px" font-weight="700" line-height="1.3" color="#FFFFFF" padding="0 16px 4px 16px">Eden's Garden &amp;&nbsp;Lounge</mj-text>
        <mj-text align="center" font-size="14px" line-height="1.5" color="#C9D6F2" padding="0 16px 14px 16px">Osuntokun, Bodija, Ibadan</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#0A1A3F" padding="22px 0 32px 0">
      <mj-column>
        <mj-text align="center" color="#E6ECF8" padding="0 40px 20px 40px">Come relax, meet new people, dance and enjoy the evening with us.</mj-text>
        <mj-button href="https://www.google.com/maps/search/?api=1&amp;query=Eden%27s+Garden+and+Lounge+Osuntokun+Bodija+Ibadan" background-color="#2EC4F1" color="#0A1A3F" font-size="17px" font-weight="700" border-radius="6px" inner-padding="16px 38px" align="center" padding="0 36px 18px 36px">Get directions</mj-button>
        <mj-text align="center" font-size="13px" line-height="1.6" color="#9FB2DA" padding="0 36px">Open to ISF delegates, partners and the wider public. By The Party People and Lightsout Production. Questions? Folu: +234&nbsp;906&nbsp;447&nbsp;3713.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Sign-off -->
    <mj-section background-color="#FFFFFF" padding="28px 0 8px 0">
      <mj-column>
        <mj-text padding="0 36px 24px 36px">See you at the movies, then poolside.<br />Team ISF<br /><span style="color:#5E6B68;">Kolawole Oluwatosin</span></mj-text>
      </mj-column>
    </mj-section>

    <!-- FIXED BOTTOM: Ibadan banner -->
    <mj-section background-color="#FFFFFF" border-radius="0 0 6px 6px">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/DaxlinksG/email-templates/isf-newsletter-assets/isf-2026/speakers-oct/isf-big-ideas-banner.jpg" width="600px" border-radius="0 0 6px 6px" href="https://luma.com/14glbn7b" alt="ISF Forum 2026 banner showing the Ibadan skyline" />
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="22px 0 30px 0">
      <mj-column>
        <mj-text font-size="13px" line-height="1.6" color="#666666" align="center" padding="0 32px 8px 32px">Follow us: <a href="https://www.instagram.com/innovationandscaleforum" style="color:#1E6F64;">Instagram</a> &middot; <a href="https://www.linkedin.com/company/isfforum" style="color:#1E6F64;">LinkedIn</a></mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">ISF Forum &middot; Ibadan, Oyo State, Nigeria</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px 6px 32px">You are receiving this email because you subscribed to updates from ISF Forum.</mj-text>
        <mj-text font-size="12px" line-height="1.6" color="#666666" align="center" padding="0 32px"><a href="{{UNSUBSCRIBE_URL}}" style="color:#666666;text-decoration:underline;">Unsubscribe</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
